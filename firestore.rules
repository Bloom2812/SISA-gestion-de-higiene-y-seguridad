rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile(appId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid));
    }

    function hasRole(appId, allowedRoles) {
      return hasUserProfile(appId)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid)).data.rol in allowedRoles;
    }

    function isAdmin(appId) {
      return hasRole(appId, ['Administrador']);
    }

    function isOccupationalHealthStaff(appId) {
      return hasRole(appId, ['Médico Ocupacional', 'Responsable H&S']);
    }

    function isIncidentManager(appId) {
      return hasRole(appId, ['Administrador', 'Responsable H&S']);
    }

    function incidentAreaExists(appId, areaId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/areas/$(areaId));
    }

    function incidentWorkerReferenceIsValid(appId, data) {
      return !data.keys().hasAny(['trabajador_id'])
        || data.trabajador_id == null
        || (data.trabajador_id is string
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/trabajadores/$(data.trabajador_id)));
    }

    function isValidIncidentTransition(previousState, nextState) {
      return previousState == nextState
        || (previousState == 'Reportado' && nextState == 'En investigación')
        || (previousState == 'En investigación'
          && nextState in ['Acciones en curso', 'Cerrado'])
        || (previousState == 'Acciones en curso'
          && nextState in ['En investigación', 'Cerrado']);
    }

    function isValidIncident(data) {
      return data.keys().hasAll([
          'codigo',
          'tipo',
          'fecha_evento',
          'area_id',
          'area_nombre',
          'descripcion',
          'gravedad',
          'estado',
          'reportado_por',
          'fecha_creacion',
          'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'codigo',
          'tipo',
          'fecha_evento',
          'area_id',
          'area_nombre',
          'lugar_especifico',
          'trabajador_id',
          'descripcion',
          'acciones_inmediatas',
          'gravedad',
          'estado',
          'reportado_por',
          'fecha_creacion',
          'ultima_actualizacion'
        ])
        && data.codigo is string
        && data.codigo.size() >= 8
        && data.codigo.size() <= 30
        && data.tipo in ['Incidente', 'Accidente', 'Cuasi accidente']
        && data.fecha_evento is timestamp
        && data.fecha_evento <= request.time
        && data.area_id is string
        && data.area_id.size() > 0
        && data.area_nombre is string
        && data.area_nombre.size() > 0
        && data.area_nombre.size() <= 120
        && (!data.keys().hasAny(['lugar_especifico'])
          || (data.lugar_especifico is string && data.lugar_especifico.size() <= 200))
        && data.descripcion is string
        && data.descripcion.size() >= 10
        && data.descripcion.size() <= 2000
        && (!data.keys().hasAny(['acciones_inmediatas'])
          || (data.acciones_inmediatas is string && data.acciones_inmediatas.size() <= 2000))
        && data.gravedad in ['Baja', 'Media', 'Alta', 'Crítica']
        && data.estado in ['Reportado', 'En investigación', 'Acciones en curso', 'Cerrado']
        && data.reportado_por is string
        && data.fecha_creacion is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function isValidIncidentHistory(data) {
      return data.keys().hasAll([
          'tipo_evento',
          'descripcion',
          'usuario_id',
          'fecha'
        ])
        && data.keys().hasOnly([
          'tipo_evento',
          'descripcion',
          'usuario_id',
          'fecha'
        ])
        && data.tipo_evento in [
          'REPORTE',
          'ACTUALIZACION',
          'CAMBIO_ESTADO',
          'INICIO_INVESTIGACION',
          'CIERRE'
        ]
        && data.descripcion is string
        && data.descripcion.size() > 0
        && data.descripcion.size() <= 1000
        && data.usuario_id is string
        && data.fecha is timestamp;
    }

    function isValidIncidentInvestigation(data) {
      return data.keys().hasAll([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'por_que_1', 'por_que_2', 'por_que_3', 'por_que_4', 'por_que_5',
          'causa_raiz', 'factores_contribuyentes', 'investigador_id',
          'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'por_que_1', 'por_que_2', 'por_que_3', 'por_que_4', 'por_que_5',
          'causa_raiz', 'factores_contribuyentes', 'investigador_id',
          'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.metodologia == '5 Porqués'
        && data.hechos_confirmados is string
        && data.hechos_confirmados.size() >= 10
        && data.hechos_confirmados.size() <= 2000
        && data.causa_inmediata is string
        && data.causa_inmediata.size() >= 5
        && data.causa_inmediata.size() <= 1000
        && data.por_que_1 is string && data.por_que_1.size() >= 5 && data.por_que_1.size() <= 1000
        && data.por_que_2 is string && data.por_que_2.size() >= 5 && data.por_que_2.size() <= 1000
        && data.por_que_3 is string && data.por_que_3.size() >= 5 && data.por_que_3.size() <= 1000
        && data.por_que_4 is string && data.por_que_4.size() >= 5 && data.por_que_4.size() <= 1000
        && data.por_que_5 is string && data.por_que_5.size() >= 5 && data.por_que_5.size() <= 1000
        && data.causa_raiz is string
        && data.causa_raiz.size() >= 5
        && data.causa_raiz.size() <= 1000
        && data.factores_contribuyentes is string
        && data.factores_contribuyentes.size() <= 2000
        && data.investigador_id is string
        && data.fecha_inicio is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    match /artifacts/{appId}/public/data {
      match /usuarios/{userId} {
        allow get: if isSignedIn()
          && (request.auth.uid == userId || isAdmin(appId));
        allow list, create, update, delete: if isAdmin(appId);
      }

      match /areas/{areaId} {
        allow read: if hasUserProfile(appId);
        allow create, update, delete:
          if hasRole(appId, ['Administrador', 'Responsable H&S']);
      }

      match /riesgos/{riesgoId} {
        allow read: if hasUserProfile(appId);
        allow create, update, delete:
          if hasRole(appId, ['Administrador', 'Responsable H&S']);
      }

      match /incidentes/{incidenteId} {
        allow read: if hasUserProfile(appId);
        allow create: if isIncidentManager(appId)
          && isValidIncident(request.resource.data)
          && incidentAreaExists(appId, request.resource.data.area_id)
          && incidentWorkerReferenceIsValid(appId, request.resource.data)
          && request.resource.data.estado == 'Reportado'
          && request.resource.data.reportado_por == request.auth.uid
          && request.resource.data.fecha_creacion == request.time
          && request.resource.data.ultima_actualizacion == request.time;
        allow update: if isIncidentManager(appId)
          && isValidIncident(request.resource.data)
          && incidentAreaExists(appId, request.resource.data.area_id)
          && incidentWorkerReferenceIsValid(appId, request.resource.data)
          && resource.data.estado != 'Cerrado'
          && isValidIncidentTransition(resource.data.estado, request.resource.data.estado)
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.reportado_por == resource.data.reportado_por
          && request.resource.data.fecha_creacion == resource.data.fecha_creacion
          && (resource.data.estado != 'Reportado'
            || request.resource.data.estado != 'En investigación'
            || existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)/investigacion/principal))
          && request.resource.data.ultima_actualizacion == request.time;
        allow delete: if false;

        // Bitácora operacional append-only del expediente.
        match /historial/{eventoId} {
          allow read: if hasUserProfile(appId);
          allow create: if isIncidentManager(appId)
            && isValidIncidentHistory(request.resource.data)
            && request.resource.data.usuario_id == request.auth.uid
            && request.resource.data.fecha == request.time;
          allow update, delete: if false;
        }

        match /investigacion/{investigacionId} {
          allow read: if hasUserProfile(appId);
          allow create: if investigacionId == 'principal'
            && isIncidentManager(appId)
            && isValidIncidentInvestigation(request.resource.data)
            && request.resource.data.investigador_id == request.auth.uid
            && request.resource.data.fecha_inicio == request.time
            && request.resource.data.ultima_actualizacion == request.time
            && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)).data.estado == 'En investigación';
          allow update: if investigacionId == 'principal'
            && isIncidentManager(appId)
            && isValidIncidentInvestigation(request.resource.data)
            && request.resource.data.investigador_id == resource.data.investigador_id
            && request.resource.data.fecha_inicio == resource.data.fecha_inicio
            && request.resource.data.ultima_actualizacion == request.time
            && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)).data.estado != 'Cerrado';
          allow delete: if false;
        }
      }

      match /capacitaciones/{capacitacionId} {
        allow read: if hasUserProfile(appId);
        allow create, update:
          if hasRole(appId, ['Administrador', 'Responsable H&S']);
        allow delete: if false;
      }

      // Contención temporal: estos documentos aún mezclan datos laborales
      // y clínicos. Se restringen hasta completar la separación.
      match /trabajadores/{trabajadorId} {
        allow read, create, update: if isOccupationalHealthStaff(appId);
        allow delete: if false;

        // Bitácora append-only.
        match /historial_ocupacional/{eventoId} {
          allow read, create: if isOccupationalHealthStaff(appId);
          allow update, delete: if false;
        }
      }

      match /salud_clinica/{trabajadorId} {
        allow read, create, update:
          if hasRole(appId, ['Médico Ocupacional']);
        allow delete: if false;
      }

      match /aptitudes_ocupacionales/{trabajadorId} {
        allow read:
          if isOccupationalHealthStaff(appId);
        allow create, update:
          if hasRole(appId, ['Médico Ocupacional']);
        allow delete: if false;
      }

      match /examenes_medicos/{examenId} {
        allow read, create, update: if isOccupationalHealthStaff(appId);
        allow delete: if false;
      }

      // Cierre por defecto.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
