rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile(appId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid));
    }

    function hasRole(appId, allowedRoles) {
      return hasUserProfile(appId)
        && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/usuarios/$(request.auth.uid)).data.rol in allowedRoles;
    }

    function isAdmin(appId) {
      return hasRole(appId, ['Administrador']);
    }

    function isOccupationalHealthStaff(appId) {
      return hasRole(appId, ['Médico Ocupacional', 'Responsable H&S']);
    }

    function isIncidentManager(appId) {
      return hasRole(appId, ['Administrador', 'Responsable H&S']);
    }

    function isTrainingManager(appId) {
      return hasRole(appId, ['Administrador', 'Responsable H&S']);
    }

    function isRiskManager(appId) {
      return hasRole(appId, ['Administrador', 'Responsable H&S']);
    }

    function isMinutesManager(appId) {
      return hasRole(appId, ['Administrador', 'Responsable H&S', 'Supervisor']);
    }

    function isValidMinutesTransition(previousState, nextState) {
      return previousState == nextState
        || (previousState == 'Borrador' && nextState in ['En seguimiento', 'Cancelada'])
        || (previousState == 'En seguimiento' && nextState == 'Cerrada');
    }

    function isValidMinutes(data) {
      return data.keys().hasAll([
          'codigo', 'tipo', 'fecha_reunion', 'lugar', 'preside', 'asunto',
          'asistentes', 'agenda', 'compromisos', 'estado', 'creado_por',
          'fecha_creacion', 'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'codigo', 'tipo', 'fecha_reunion', 'lugar', 'preside', 'asunto',
          'asistentes', 'agenda', 'compromisos', 'estado', 'creado_por',
          'fecha_creacion', 'ultima_actualizacion'
        ])
        && data.codigo is string && data.codigo.size() >= 10 && data.codigo.size() <= 30
        && data.tipo in ['Ordinaria', 'Extraordinaria', 'Comité H&S', 'Investigación', 'Seguimiento']
        && data.fecha_reunion is timestamp
        && data.lugar is string && data.lugar.size() >= 2 && data.lugar.size() <= 160
        && data.preside is string && data.preside.size() >= 2 && data.preside.size() <= 120
        && data.asunto is string && data.asunto.size() >= 5 && data.asunto.size() <= 200
        && data.asistentes is list && data.asistentes.size() >= 1 && data.asistentes.size() <= 100
        && data.agenda is string && data.agenda.size() >= 5 && data.agenda.size() <= 4000
        && data.compromisos is list && data.compromisos.size() >= 1 && data.compromisos.size() <= 100
        && data.estado in ['Borrador', 'En seguimiento', 'Cerrada', 'Cancelada']
        && data.creado_por is string
        && data.fecha_creacion is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function riskAreaExists(appId, areaId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/areas/$(areaId));
    }

    function isValidRiskPriority(priority) {
      return priority in ['Baja', 'Moderada', 'Alta', 'Crítica'];
    }

    function isValidRiskTransition(previousState, nextState) {
      return previousState == nextState
        || (previousState == 'Identificado' && nextState in ['En tratamiento', 'Controlado', 'Archivado'])
        || (previousState == 'En tratamiento' && nextState in ['Controlado', 'Archivado'])
        || (previousState == 'Controlado' && nextState in ['En tratamiento', 'Archivado']);
    }

    function hasValidCommonRiskFields(appId, data) {
      return data.keys().hasAll([
          'codigo', 'metodologia', 'area_id', 'area_nombre', 'actividad',
          'peligro', 'consecuencia', 'controles_existentes', 'responsable',
          'estado', 'nivel_riesgo', 'prioridad', 'creado_por',
          'fecha_creacion', 'ultima_actualizacion'
        ])
        && data.codigo is string && data.codigo.size() >= 10 && data.codigo.size() <= 30
        && data.metodologia in ['Matriz 5x5', 'JSA 5x5', 'NTP 330']
        && data.area_id is string && data.area_id.size() > 0
        && riskAreaExists(appId, data.area_id)
        && data.area_nombre is string && data.area_nombre.size() >= 2 && data.area_nombre.size() <= 120
        && data.actividad is string && data.actividad.size() >= 3 && data.actividad.size() <= 160
        && data.peligro is string && data.peligro.size() >= 5 && data.peligro.size() <= 500
        && data.consecuencia is string && data.consecuencia.size() >= 5 && data.consecuencia.size() <= 500
        && data.controles_existentes is string && data.controles_existentes.size() >= 1 && data.controles_existentes.size() <= 1000
        && data.responsable is string && data.responsable.size() >= 2 && data.responsable.size() <= 120
        && data.estado in ['Identificado', 'En tratamiento', 'Controlado', 'Archivado']
        && data.nivel_riesgo is int && data.nivel_riesgo >= 0
        && isValidRiskPriority(data.prioridad)
        && data.creado_por is string
        && data.fecha_creacion is timestamp
        && data.ultima_actualizacion is timestamp
        && (!data.keys().hasAny(['lugar']) || (data.lugar is string && data.lugar.size() <= 160))
        && (!data.keys().hasAny(['fecha_compromiso']) || data.fecha_compromiso is timestamp);
    }

    function isValidFiveByFiveRisk(data) {
      return data.metodologia in ['Matriz 5x5', 'JSA 5x5']
        && data.keys().hasAll(['probabilidad', 'severidad'])
        && data.probabilidad is int && data.probabilidad >= 1 && data.probabilidad <= 5
        && data.severidad is int && data.severidad >= 1 && data.severidad <= 5
        && data.nivel_riesgo == data.probabilidad * data.severidad
        && !data.keys().hasAny(['nivel_deficiencia', 'nivel_exposicion', 'nivel_consecuencia'])
        && ((data.nivel_riesgo >= 20 && data.prioridad == 'Crítica')
          || (data.nivel_riesgo >= 10 && data.nivel_riesgo < 20 && data.prioridad == 'Alta')
          || (data.nivel_riesgo >= 5 && data.nivel_riesgo < 10 && data.prioridad == 'Moderada')
          || (data.nivel_riesgo < 5 && data.prioridad == 'Baja'))
        && ((data.metodologia == 'Matriz 5x5' && !data.keys().hasAny(['paso_tarea']))
          || (data.metodologia == 'JSA 5x5'
            && data.paso_tarea is string
            && data.paso_tarea.size() >= 3
            && data.paso_tarea.size() <= 200));
    }

    function isValidNtp330Risk(data) {
      return data.metodologia == 'NTP 330'
        && data.keys().hasAll(['nivel_deficiencia', 'nivel_exposicion', 'nivel_consecuencia'])
        && data.nivel_deficiencia in [0, 2, 6, 10]
        && data.nivel_exposicion in [1, 2, 3, 4]
        && data.nivel_consecuencia in [10, 25, 60, 100]
        && data.nivel_riesgo == data.nivel_deficiencia * data.nivel_exposicion * data.nivel_consecuencia
        && !data.keys().hasAny(['probabilidad', 'severidad', 'paso_tarea'])
        && ((data.nivel_riesgo >= 600 && data.prioridad == 'Crítica')
          || (data.nivel_riesgo >= 150 && data.nivel_riesgo < 600 && data.prioridad == 'Alta')
          || (data.nivel_riesgo >= 40 && data.nivel_riesgo < 150 && data.prioridad == 'Moderada')
          || (data.nivel_riesgo < 40 && data.prioridad == 'Baja'));
    }

    function isValidRisk(appId, data) {
      return hasValidCommonRiskFields(appId, data)
        && data.keys().hasOnly([
          'codigo', 'metodologia', 'area_id', 'area_nombre', 'actividad', 'lugar',
          'paso_tarea', 'peligro', 'consecuencia', 'controles_existentes',
          'probabilidad', 'severidad', 'nivel_deficiencia', 'nivel_exposicion',
          'nivel_consecuencia', 'nivel_riesgo', 'prioridad', 'responsable',
          'fecha_compromiso', 'estado', 'creado_por', 'fecha_creacion',
          'ultima_actualizacion'
        ])
        && (isValidFiveByFiveRisk(data) || isValidNtp330Risk(data));
    }

    function trainingAreaReferenceIsValid(appId, data) {
      return (data.alcance == 'Toda la organización'
          && !data.keys().hasAny(['area_id', 'area_nombre']))
        || (data.alcance == 'Área específica'
          && data.keys().hasAll(['area_id', 'area_nombre'])
          && data.area_id is string
          && data.area_id.size() > 0
          && data.area_nombre is string
          && data.area_nombre.size() > 0
          && data.area_nombre.size() <= 120
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/areas/$(data.area_id)));
    }

    function isValidTrainingTransition(previousState, nextState) {
      return previousState == nextState
        || (previousState == 'Programada' && nextState in ['En curso', 'Cancelada'])
        || (previousState == 'En curso' && nextState in ['Completada', 'Cancelada']);
    }

    function isValidTraining(appId, data) {
      return data.keys().hasAll([
          'codigo', 'titulo', 'categoria', 'modalidad', 'fecha_inicio',
          'duracion_minutos', 'instructor', 'alcance', 'estado',
          'creado_por', 'fecha_creacion', 'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'codigo', 'titulo', 'categoria', 'modalidad', 'fecha_inicio',
          'duracion_minutos', 'instructor', 'alcance', 'area_id', 'area_nombre',
          'lugar', 'objetivo', 'estado', 'creado_por', 'fecha_creacion',
          'ultima_actualizacion'
        ])
        && data.codigo is string && data.codigo.size() >= 8 && data.codigo.size() <= 30
        && data.titulo is string && data.titulo.size() >= 5 && data.titulo.size() <= 160
        && data.categoria is string && data.categoria.size() >= 2 && data.categoria.size() <= 80
        && data.modalidad in ['Presencial', 'Virtual', 'Mixta', 'Práctica en puesto']
        && data.fecha_inicio is timestamp
        && data.duracion_minutos is int && data.duracion_minutos >= 15 && data.duracion_minutos <= 1440
        && data.instructor is string && data.instructor.size() >= 2 && data.instructor.size() <= 120
        && data.alcance in ['Toda la organización', 'Área específica']
        && trainingAreaReferenceIsValid(appId, data)
        && (!data.keys().hasAny(['lugar']) || (data.lugar is string && data.lugar.size() <= 200))
        && (!data.keys().hasAny(['objetivo']) || (data.objetivo is string && data.objetivo.size() <= 1000))
        && data.estado in ['Programada', 'En curso', 'Completada', 'Cancelada']
        && data.creado_por is string
        && data.fecha_creacion is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function incidentAreaExists(appId, areaId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/areas/$(areaId));
    }

    function incidentWorkerReferenceIsValid(appId, data) {
      return !data.keys().hasAny(['trabajador_id'])
        || data.trabajador_id == null
        || (data.trabajador_id is string
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/trabajadores/$(data.trabajador_id)));
    }

    function isValidIncidentTransition(previousState, nextState) {
      return previousState == nextState
        || (previousState == 'Reportado' && nextState == 'En investigación')
        || (previousState == 'En investigación'
          && nextState in ['Acciones en curso', 'Cerrado'])
        || (previousState == 'Acciones en curso'
          && nextState in ['En investigación', 'Cerrado']);
    }

    function isValidIncident(data) {
      return data.keys().hasAll([
          'codigo',
          'tipo',
          'fecha_evento',
          'area_id',
          'area_nombre',
          'descripcion',
          'gravedad',
          'estado',
          'reportado_por',
          'fecha_creacion',
          'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'codigo',
          'tipo',
          'fecha_evento',
          'area_id',
          'area_nombre',
          'lugar_especifico',
          'trabajador_id',
          'descripcion',
          'acciones_inmediatas',
          'gravedad',
          'estado',
          'reportado_por',
          'fecha_creacion',
          'ultima_actualizacion'
        ])
        && data.codigo is string
        && data.codigo.size() >= 8
        && data.codigo.size() <= 30
        && data.tipo in ['Incidente', 'Accidente', 'Cuasi accidente']
        && data.fecha_evento is timestamp
        && data.fecha_evento <= request.time
        && data.area_id is string
        && data.area_id.size() > 0
        && data.area_nombre is string
        && data.area_nombre.size() > 0
        && data.area_nombre.size() <= 120
        && (!data.keys().hasAny(['lugar_especifico'])
          || (data.lugar_especifico is string && data.lugar_especifico.size() <= 200))
        && data.descripcion is string
        && data.descripcion.size() >= 10
        && data.descripcion.size() <= 2000
        && (!data.keys().hasAny(['acciones_inmediatas'])
          || (data.acciones_inmediatas is string && data.acciones_inmediatas.size() <= 2000))
        && data.gravedad in ['Baja', 'Media', 'Alta', 'Crítica']
        && data.estado in ['Reportado', 'En investigación', 'Acciones en curso', 'Cerrado']
        && data.reportado_por is string
        && data.fecha_creacion is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function isValidIncidentHistory(data) {
      return data.keys().hasAll([
          'tipo_evento',
          'descripcion',
          'usuario_id',
          'fecha'
        ])
        && data.keys().hasOnly([
          'tipo_evento',
          'descripcion',
          'usuario_id',
          'fecha'
        ])
        && data.tipo_evento in [
          'REPORTE',
          'ACTUALIZACION',
          'CAMBIO_ESTADO',
          'INICIO_INVESTIGACION',
          'CIERRE'
        ]
        && data.descripcion is string
        && data.descripcion.size() > 0
        && data.descripcion.size() <= 1000
        && data.usuario_id is string
        && data.fecha is timestamp;
    }

    function isValidLegacyFiveWhysInvestigation(data) {
      return data.keys().hasAll([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'por_que_1', 'por_que_2', 'por_que_3', 'por_que_4', 'por_que_5',
          'causa_raiz', 'factores_contribuyentes', 'investigador_id',
          'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'por_que_1', 'por_que_2', 'por_que_3', 'por_que_4', 'por_que_5',
          'causa_raiz', 'factores_contribuyentes', 'investigador_id',
          'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.metodologia == '5 Porqués'
        && data.hechos_confirmados is string
        && data.hechos_confirmados.size() >= 10
        && data.hechos_confirmados.size() <= 2000
        && data.causa_inmediata is string
        && data.causa_inmediata.size() >= 5
        && data.causa_inmediata.size() <= 1000
        && data.por_que_1 is string && data.por_que_1.size() >= 5 && data.por_que_1.size() <= 1000
        && data.por_que_2 is string && data.por_que_2.size() >= 5 && data.por_que_2.size() <= 1000
        && data.por_que_3 is string && data.por_que_3.size() >= 5 && data.por_que_3.size() <= 1000
        && data.por_que_4 is string && data.por_que_4.size() >= 5 && data.por_que_4.size() <= 1000
        && data.por_que_5 is string && data.por_que_5.size() >= 5 && data.por_que_5.size() <= 1000
        && data.causa_raiz is string
        && data.causa_raiz.size() >= 5
        && data.causa_raiz.size() <= 1000
        && data.factores_contribuyentes is string
        && data.factores_contribuyentes.size() <= 2000
        && data.investigador_id is string
        && data.fecha_inicio is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function isValidCurrentIncidentInvestigation(data) {
      return data.keys().hasAll([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'analisis_metodo', 'causa_raiz', 'factores_contribuyentes',
          'investigador_id', 'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.keys().hasOnly([
          'metodologia', 'hechos_confirmados', 'causa_inmediata',
          'analisis_metodo', 'causa_raiz', 'factores_contribuyentes',
          'investigador_id', 'fecha_inicio', 'ultima_actualizacion'
        ])
        && data.metodologia in ['5 Porqués', 'Ishikawa 6M', 'Análisis de barreras']
        && data.hechos_confirmados is string
        && data.hechos_confirmados.size() >= 10
        && data.hechos_confirmados.size() <= 2000
        && data.causa_inmediata is string
        && data.causa_inmediata.size() >= 5
        && data.causa_inmediata.size() <= 1000
        && data.analisis_metodo is map
        && data.analisis_metodo.keys().hasAll([
          'respuesta_1', 'respuesta_2', 'respuesta_3',
          'respuesta_4', 'respuesta_5', 'respuesta_6'
        ])
        && data.analisis_metodo.keys().hasOnly([
          'respuesta_1', 'respuesta_2', 'respuesta_3',
          'respuesta_4', 'respuesta_5', 'respuesta_6'
        ])
        && data.analisis_metodo.respuesta_1 is string
        && data.analisis_metodo.respuesta_1.size() >= 5
        && data.analisis_metodo.respuesta_1.size() <= 1000
        && data.analisis_metodo.respuesta_2 is string
        && data.analisis_metodo.respuesta_2.size() >= 5
        && data.analisis_metodo.respuesta_2.size() <= 1000
        && data.analisis_metodo.respuesta_3 is string
        && data.analisis_metodo.respuesta_3.size() >= 5
        && data.analisis_metodo.respuesta_3.size() <= 1000
        && data.analisis_metodo.respuesta_4 is string
        && data.analisis_metodo.respuesta_4.size() >= 5
        && data.analisis_metodo.respuesta_4.size() <= 1000
        && data.analisis_metodo.respuesta_5 is string
        && data.analisis_metodo.respuesta_5.size() >= 5
        && data.analisis_metodo.respuesta_5.size() <= 1000
        && data.analisis_metodo.respuesta_6 is string
        && data.analisis_metodo.respuesta_6.size() <= 1000
        && (
          (data.metodologia == '5 Porqués' && data.analisis_metodo.respuesta_6 == '')
          || (data.metodologia in ['Ishikawa 6M', 'Análisis de barreras']
            && data.analisis_metodo.respuesta_6.size() >= 5)
        )
        && data.causa_raiz is string
        && data.causa_raiz.size() >= 5
        && data.causa_raiz.size() <= 1000
        && data.factores_contribuyentes is string
        && data.factores_contribuyentes.size() <= 2000
        && data.investigador_id is string
        && data.fecha_inicio is timestamp
        && data.ultima_actualizacion is timestamp;
    }

    function isValidIncidentInvestigation(data) {
      return isValidLegacyFiveWhysInvestigation(data)
        || isValidCurrentIncidentInvestigation(data);
    }

    match /artifacts/{appId}/public/data {
      match /usuarios/{userId} {
        allow get: if isSignedIn()
          && (request.auth.uid == userId || isAdmin(appId));
        allow list, create, update, delete: if isAdmin(appId);
      }

      match /areas/{areaId} {
        allow read: if hasUserProfile(appId);
        allow create, update, delete:
          if hasRole(appId, ['Administrador', 'Responsable H&S']);
      }

      match /riesgos/{riesgoId} {
        allow read: if hasUserProfile(appId);
        allow create: if isRiskManager(appId)
          && isValidRisk(appId, request.resource.data)
          && request.resource.data.creado_por == request.auth.uid
          && request.resource.data.fecha_creacion == request.time
          && request.resource.data.ultima_actualizacion == request.time;
        allow update: if isRiskManager(appId)
          && isValidRisk(appId, request.resource.data)
          && isValidRiskTransition(resource.data.estado, request.resource.data.estado)
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.metodologia == resource.data.metodologia
          && request.resource.data.creado_por == resource.data.creado_por
          && request.resource.data.fecha_creacion == resource.data.fecha_creacion
          && request.resource.data.ultima_actualizacion == request.time;
        allow delete: if false;
      }

      match /actas/{actaId} {
        allow read: if hasUserProfile(appId);
        allow create: if isMinutesManager(appId)
          && isValidMinutes(request.resource.data)
          && request.resource.data.estado == 'Borrador'
          && request.resource.data.creado_por == request.auth.uid
          && request.resource.data.fecha_creacion == request.time
          && request.resource.data.ultima_actualizacion == request.time;
        allow update: if isMinutesManager(appId)
          && isValidMinutes(request.resource.data)
          && isValidMinutesTransition(resource.data.estado, request.resource.data.estado)
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.creado_por == resource.data.creado_por
          && request.resource.data.fecha_creacion == resource.data.fecha_creacion
          && request.resource.data.ultima_actualizacion == request.time;
        allow delete: if false;
      }

      match /incidentes/{incidenteId} {
        allow read: if hasUserProfile(appId);
        allow create: if isIncidentManager(appId)
          && isValidIncident(request.resource.data)
          && incidentAreaExists(appId, request.resource.data.area_id)
          && incidentWorkerReferenceIsValid(appId, request.resource.data)
          && request.resource.data.estado == 'Reportado'
          && request.resource.data.reportado_por == request.auth.uid
          && request.resource.data.fecha_creacion == request.time
          && request.resource.data.ultima_actualizacion == request.time;
        allow update: if isIncidentManager(appId)
          && isValidIncident(request.resource.data)
          && incidentAreaExists(appId, request.resource.data.area_id)
          && incidentWorkerReferenceIsValid(appId, request.resource.data)
          && resource.data.estado != 'Cerrado'
          && isValidIncidentTransition(resource.data.estado, request.resource.data.estado)
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.reportado_por == resource.data.reportado_por
          && request.resource.data.fecha_creacion == resource.data.fecha_creacion
          && (resource.data.estado != 'Reportado'
            || request.resource.data.estado != 'En investigación'
            || existsAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)/investigacion/principal))
          && request.resource.data.ultima_actualizacion == request.time;
        allow delete: if false;

        // Bitácora operacional append-only del expediente.
        match /historial/{eventoId} {
          allow read: if hasUserProfile(appId);
          allow create: if isIncidentManager(appId)
            && isValidIncidentHistory(request.resource.data)
            && request.resource.data.usuario_id == request.auth.uid
            && request.resource.data.fecha == request.time;
          allow update, delete: if false;
        }

        match /investigacion/{investigacionId} {
          allow read: if hasUserProfile(appId);
          allow create: if investigacionId == 'principal'
            && isIncidentManager(appId)
            && isValidIncidentInvestigation(request.resource.data)
            && request.resource.data.investigador_id == request.auth.uid
            && request.resource.data.fecha_inicio == request.time
            && request.resource.data.ultima_actualizacion == request.time
            && getAfter(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)).data.estado == 'En investigación';
          allow update: if investigacionId == 'principal'
            && isIncidentManager(appId)
            && isValidIncidentInvestigation(request.resource.data)
            && request.resource.data.investigador_id == resource.data.investigador_id
            && request.resource.data.fecha_inicio == resource.data.fecha_inicio
            && request.resource.data.ultima_actualizacion == request.time
            && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/incidentes/$(incidenteId)).data.estado != 'Cerrado';
          allow delete: if false;
        }
      }

      match /capacitaciones/{capacitacionId} {
        allow read: if hasUserProfile(appId);
        allow create: if isTrainingManager(appId)
          && isValidTraining(appId, request.resource.data)
          && request.resource.data.estado == 'Programada'
          && request.resource.data.creado_por == request.auth.uid
          && request.resource.data.fecha_creacion == request.time
          && request.resource.data.ultima_actualizacion == request.time;
        allow update: if isTrainingManager(appId)
          && isValidTraining(appId, request.resource.data)
          && isValidTrainingTransition(resource.data.estado, request.resource.data.estado)
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.creado_por == resource.data.creado_por
          && request.resource.data.fecha_creacion == resource.data.fecha_creacion
          && request.resource.data.ultima_actualizacion == request.time;
        allow delete: if false;
      }

      // Contención temporal: estos documentos aún mezclan datos laborales
      // y clínicos. Se restringen hasta completar la separación.
      match /trabajadores/{trabajadorId} {
        allow read, create, update: if isOccupationalHealthStaff(appId);
        allow delete: if false;

        // Bitácora append-only.
        match /historial_ocupacional/{eventoId} {
          allow read, create: if isOccupationalHealthStaff(appId);
          allow update, delete: if false;
        }
      }

      match /salud_clinica/{trabajadorId} {
        allow read, create, update:
          if hasRole(appId, ['Médico Ocupacional']);
        allow delete: if false;
      }

      match /aptitudes_ocupacionales/{trabajadorId} {
        allow read:
          if isOccupationalHealthStaff(appId);
        allow create, update:
          if hasRole(appId, ['Médico Ocupacional']);
        allow delete: if false;
      }

      match /examenes_medicos/{examenId} {
        allow read, create, update: if isOccupationalHealthStaff(appId);
        allow delete: if false;
      }

      // Cierre por defecto.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
